#include <stdio.h>

int main() {
    int n, a, b, siguiente, i;

    printf("Ingrese un numero mayor o igual que 1: ");
    scanf("%d", &n);

    if (n < 1) {
        printf("Numero no valido\n");
    } else {
        a = 0;
        b = 1;

        for (i = 1; i <= n; i++) {
            printf("%d\n", a);

            siguiente = a + b;
            a = b;
            b = siguiente;
        }
    }

    return 0;
}
