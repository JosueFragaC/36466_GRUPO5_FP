#include <stdio.h>

int main() {
    int n, i;
    int es_primo;

    printf("Ingrese un numero entero mayor que 1: ");
    scanf("%d", &n);

    if (n <= 1) {
        printf("El numero debe ser mayor que 1\n");
    } else {
        es_primo = 1;
        i = 2;

        while (i < n && es_primo == 1) {
            if (n % i == 0) {
                es_primo = 0;
            }

            i = i + 1;
        }

        if (es_primo == 1) {
            printf("El numero es primo\n");
        } else {
            printf("El numero no es primo\n");
        }
    }

    return 0;
}
