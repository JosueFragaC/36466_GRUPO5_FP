#include <stdio.h>

int main() {
    int total, dias, horas, minutos, segundos;

    printf("Ingrese la cantidad de segundos: ");
    scanf("%d", &total);

    dias = total / 86400;
    total = total % 86400;

    horas = total / 3600;
    total = total % 3600;

    minutos = total / 60;
    segundos = total % 60;

    printf("Dias: %d\n", dias);
    printf("Horas: %d\n", horas);
    printf("Minutos: %d\n", minutos);
    printf("Segundos: %d\n", segundos);

    return 0;
}
